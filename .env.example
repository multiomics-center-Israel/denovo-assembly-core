# ---- Agent service (Railway) ----
OPENROUTER_API_KEY=sk-or-...            # required
OPENROUTER_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Public URLs (set after the services have domains)
JBROWSE_URL=https://spalangia-jbrowse.up.railway.app
SITE_URL=https://spalangia-jbrowse.up.railway.app
ASSEMBLY_NAME=spalangia_cameroni

# Shared-password gate for /chat and POST /blast-results (leave blank = open)
SITE_USER=spalangia
SITE_PASSWORD=changeme

# CORS: the JBrowse origin must be allowed to fetch the agent's blast GFF
CORS_ORIGINS=https://spalangia-jbrowse.up.railway.app

# Where the agent pulls its data on boot (Supabase public bucket base);
# printed by supabase/upload.sh. Cached on the mounted volume.
DATA_BASE=https://YOURPROJECT.supabase.co/storage/v1/object/public/genome
# FETCH_ASSEMBLY=1   # set 0 to skip the 160 MB FASTA (disables contig_stats GC)

# ---- Supabase upload (local, supabase/upload.sh) ----
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...            # service_role key (write access)
SUPABASE_BUCKET=genome

# ---- Local BLAST client (local-blast/run_blast.sh, post_results.py) ----
AGENT_URL=https://spalangia-agent.up.railway.app
# SITE_USER / SITE_PASSWORD reused for upload auth
